# Server-side only. With managed identity (org policy), no key is needed.
AZURE_SPEECH_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
AZURE_SPEECH_REGION=eastus2
VOICE_LIVE_MODEL=<your-ga-model-deployment>
VOICE_LIVE_API_VERSION=<current-ga-api-version>
TTS_VOICE=en-IN-Neerja:DragonHDLatestNeural
STT_LANGUAGES=en-IN,ta-IN
# Keep true in production and enable App Service Authentication with Microsoft Entra.
REQUIRE_APP_AUTH=false
ENTRA_TENANT_ID=<your-tenant-id>
ENTRA_CLIENT_ID=<your-app-registration-client-id>
# Optional additional origins; same-origin requests are allowed automatically.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
